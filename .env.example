# 直播小幫手 — 水平擴展部署的 .env 範例（計畫 §6.1）
# 複製為 .env 並填入實際值；.env 已列入 .gitignore，切勿提交。
#
# 【設計原則】.env 盡量瘦：只放「Docker Compose 解析 compose 檔時需要的變數」。
#   應用程式本身的設定（Token、連線字串等）預設放 bot_config.json（掛載進容器），
#   不要在這裡重複塞 —— 這裡設了會以 env 覆寫 bot_config.json，兩份容易漂移。

# ── 叢集（必填，Compose 插值用）──
# TOTAL_SHARDS 是 shard 總數的單一真實來源：
#   - 插值到各 notifier-N 服務 command 的第二參數（compose 檔）
#   - 同時當 coordinator / scraper 的 env 覆寫其 TotalShards
# 【約束】必須等於 docker-compose.yml 內 notifier-N 服務的「數量」（現為 2 → notifier-0, notifier-1）。
TOTAL_SHARDS=2

# 備註：內部通知匯流排走 Redis Streams（bot:notify），就在 bot_config.json 的 RedisOption 指向的 Redis 上，
# 無需額外設定（§3/§4）。角色由執行檔決定，無偵測/匯流排旗標。

# ── 以下為「選用」的 env 覆寫（有對應環境變數者）──
# 預設請留空、改在 bot_config.json 設定；只有在你想用 env 注入機密（不進 bot_config.json）時才填。
# 有 env 覆寫的欄位僅：MYSQL_CONNECTION_STRING / REDIS_OPTION / PROVIDER_TOKEN_ENCRYPTION_KEY /
#   DISCORD_TOKEN / GOOGLE_API_KEY / LOKI_URL / TOTAL_SHARDS / ENABLE_GUILD_MEMBERS_INTENT
#MYSQL_CONNECTION_STRING=server=host.docker.internal;port=3306;database=discord_stream_bot;user=stream_bot;password=CHANGE_ME
#REDIS_OPTION=host.docker.internal:6379,password=CHANGE_ME,syncTimeout=3000
# Bot 與 Backend 必須使用同一個既有金鑰，長度至少 64 字元；切勿產生新值覆蓋現行密文。
#PROVIDER_TOKEN_ENCRYPTION_KEY=CHANGE_ME_KEEP_THE_EXISTING_SHARED_KEY_AT_LEAST_64_CHARACTERS_LONG
#DISCORD_TOKEN=CHANGE_ME
#GOOGLE_API_KEY=CHANGE_ME
#LOKI_URL=http://host.docker.internal:3100/loki/api/v1/push

# 備註：以下設定「無」對應環境變數，只能放 bot_config.json：
#   WebHookUrl、ApiServerDomain、
#   GoogleClientId/Secret、TwitCasting*/Twitch*、TestSlashCommandGuildIds 等。
