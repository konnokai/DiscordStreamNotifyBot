  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube get-member-only-playlist permissions=- dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
