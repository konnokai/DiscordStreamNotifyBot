slash-contract v1
[global]
group /help
group /server-admin
group /twitch
group /twitch-spider
group /utility
group /youtube
group /youtube-spider
command /help get-all-commands permissions=- dm=true nsfw=false contexts=- integrations=-
  option 0 module type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /help get-all-modules permissions=- dm=true nsfw=false contexts=- integrations=-
command /help get-command-help permissions=- dm=true nsfw=false contexts=- integrations=-
  option 0 module type=String required=false autocomplete=true channels=- min=- max=- minLength=- maxLength=-
  option 1 command type=String required=false autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /server-admin send-message-to-bot-owner permissions=Administrator dm=true nsfw=false contexts=- integrations=-
command /server-admin set-global-notice-channel permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=Channel required=true autocomplete=false channels=Text,News min=- max=- minLength=- maxLength=-
command /server-admin set-language permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 language type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
    choice 0 name="Traditional Chinese" value="zh-TW"
    choice 1 name="English" value="en-US"
    choice 2 name="Japanese" value="ja"
command /twitch-spider add permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /twitch-spider list permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /twitch-spider list-not-trusted permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /twitch-spider remove permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /twitch add permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 streamer type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
  option 1 notification-channel type=Channel required=true autocomplete=false channels=Text,News min=- max=- minLength=- maxLength=-
command /twitch list permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /twitch list-message permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /twitch remove permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /twitch set-message permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
  option 1 notification-type type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
    choice 0 name="Stream started" value="0"
    choice 1 name="Stream ended" value="1"
    choice 2 name="Stream details changed" value="2"
  option 2 message type=String required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /utility invite permissions=- dm=true nsfw=false contexts=- integrations=-
command /utility ping permissions=- dm=true nsfw=false contexts=- integrations=-
command /utility status permissions=- dm=true nsfw=false contexts=- integrations=-
command /youtube-spider add permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube-spider list permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube-spider list-not-trusted permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube-spider remove permissions=Administrator dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /youtube add permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 channel-or-group type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
  option 1 channel type=Channel required=true autocomplete=false channels=Text,News min=- max=- minLength=- maxLength=-
command /youtube coming-soon-stream permissions=- dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube get-member-only-playlist permissions=- dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube list permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube list-message permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 page type=Integer required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube remove permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
command /youtube set-banner-change permissions=ManageGuild dm=true nsfw=false contexts=- integrations=-
  option 0 channel-url type=String required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube set-message permissions=ManageMessages, MentionEveryone dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
  option 1 notification-type type=String required=true autocomplete=false channels=- min=- max=- minLength=- maxLength=-
    choice 0 name="New waiting room" value="0"
    choice 1 name="New upload" value="1"
    choice 2 name="Stream or premiere started" value="2"
    choice 3 name="Stream or premiere ended" value="3"
    choice 4 name="Schedule changed" value="4"
    choice 5 name="Deleted or made private" value="5"
  option 2 message type=String required=false autocomplete=false channels=- min=- max=- minLength=- maxLength=-
command /youtube set-video-notice-channel permissions=ManageMessages dm=true nsfw=false contexts=- integrations=-
  option 0 youtube-channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
  option 1 notification-channel type=Channel required=true autocomplete=false channels=Text,News min=- max=- minLength=- maxLength=-
command /youtube toggle-create-event permissions=ManageEvents dm=true nsfw=false contexts=- integrations=-
  option 0 channel type=String required=true autocomplete=true channels=- min=- max=- minLength=- maxLength=-
[guild-only]
